# Local adapters are only allowed under next dev / tests, never production.
STAVIRA_MODE=local
STAVIRA_DATA_DIR=.data
# AWS mode: set all below; frontend secrets stay server-side.
# STAVIRA_MODE=aws
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
STAVIRA_API_URL=
STAVIRA_TABLE=
BEDROCK_MODEL_ID=
# Exact deployed frontend origin for CSRF checks and API CORS
APP_ORIGIN=http://127.0.0.1:3000
